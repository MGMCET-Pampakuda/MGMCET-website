# =============================================================================
# MGM College of Engineering and Technology (MGMCET) - Environment Variables
# Copy this file to .env.local and fill in your values.
# =============================================================================

# Firebase Client Configuration (Firestore Contact & Enquiry Forms, Admin Auth)
# The static site builds cleanly without these.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Dev-only Design System Route (/design-system)
# Set to 'true' during local component development; leave false in production.
NEXT_PUBLIC_SHOW_DESIGN_SYSTEM=false

# ImageKit CDN & Media Management
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/miwqceyia
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
